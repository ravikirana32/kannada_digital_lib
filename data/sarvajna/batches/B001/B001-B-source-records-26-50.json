    },
    {
      "candidate_id": "CAND-0042",
      "canonical_id": null,
      "source_id": "SRC-002",
      "source_name": "Kannada Wikisource",
      "source_number": 42,
      "section": "ಜಾತಿಸ್ಮರಣ ಪದ್ದತಿ",
      "text": "ತುಪ್ಪವಾದಾ ಬಳಿಕ । ಹೆಪ್ಪನೆರೆದವರುಂಟೆ\nನಿಃಪತಿಯಾದ ಗುರುವಿನುಪದೇಶದಿಂ\nತಪ್ಪದೇ ಮುಕ್ತಿ ಸರ್ವಜ್ಞ",
      "locator": "https://kn.wikisource.org/wiki/ಸರ್ವಜ್ಞನ_ವಚನಗಳು#ಜಾತಿಸ್ಮರಣ_ಪದ್ದತಿ",
