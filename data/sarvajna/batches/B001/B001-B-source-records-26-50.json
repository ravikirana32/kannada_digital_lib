    },
    {
      "candidate_id": "CAND-0041",
      "canonical_id": null,
      "source_id": "SRC-002",
      "source_name": "Kannada Wikisource",
      "source_number": 41,
      "section": "ಜಾತಿಸ್ಮರಣ ಪದ್ದತಿ",
      "text": "ಮನವು ಮುಟ್ಟಲು ಗಂಡು । ತನವು ಸೋಂಕಲು ಪಾಪ\nಮನವೇಕದಿಂದ ಗುರುಚರಣ - ಸೋಂಕಿದೊಡೆ\nತನು ಶುದ್ದವಯ್ಯ ಸರ್ವಜ್ಞ",
      "locator": "https://kn.wikisource.org/wiki/ಸರ್ವಜ್ಞನ_ವಚನಗಳು#ಜಾತಿಸ್ಮರಣ_ಪದ್ದತಿ",
      "fingerprint_sha256": "615c3e7f127c57609e063aad9fcce6ce742f1ca587131de5c0f19210018092e8",
      "source_license": "CC BY-SA (Wikisource work page)",
