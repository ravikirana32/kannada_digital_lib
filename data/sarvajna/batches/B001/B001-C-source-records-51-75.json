    },
    {
      "candidate_id": "CAND-0063",
      "canonical_id": null,
      "source_id": "SRC-002",
      "source_name": "Kannada Wikisource",
      "source_number": 63,
      "section": "ಲಿಂಗಾತಿಶಯ ಪದ್ಧತಿ",
      "text": "ಓಂಕಾರ ತಾನಲ್ಲ । ಹ್ರಾಂಕಾರ ಮುನ್ನಲ್ಲ\nಆಂಕಾಶತಳವ ಮೀರೆಹುದು - ಹರಿಯಜರು\nತಾಂ ಕಾಣರಯ್ಯ ಸರ್ವಜ್ಞ",
      "locator": "https://kn.wikisource.org/wiki/ಸರ್ವಜ್ಞನ_ವಚನಗಳು",
      "fingerprint_sha256": "a71b9a8c456e75a3b4c6b3c42f4704ca4c6f13bd158638bb519934b68ffaed31",
      "source_license": "CC BY-SA (Wikisource work page)",
