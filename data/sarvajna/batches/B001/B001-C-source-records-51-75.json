    },
    {
      "candidate_id": "CAND-0064",
      "canonical_id": null,
      "source_id": "SRC-002",
      "source_name": "Kannada Wikisource",
      "source_number": 64,
      "section": "ಲಿಂಗಾತಿಶಯ ಪದ್ಧತಿ",
      "text": "ಓರ್ವನಲ್ಲದೆ ಮತ್ತೆ । ಇರ್ವರುಂಟೇ ಮರುಳೆ\nಸರ್ವಜ್ಞನೊರ್ವ ಜಗಕೆಲ್ಲ - ಕರ್ತಾರ\nನೊರ್ವನೇ ದೇವ ಸರ್ವಜ್ಞ",
      "locator": "https://kn.wikisource.org/wiki/ಸರ್ವಜ್ಞನ_ವಚನಗಳು",
      "fingerprint_sha256": "11718a3ad17322dca99d2c83189beef180c1fa74130d2ed1008c48a3f7be0501",
      "source_license": "CC BY-SA (Wikisource work page)",
