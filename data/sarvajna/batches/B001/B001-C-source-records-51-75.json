      "canonical_id": null,
      "source_id": "SRC-002",
      "source_name": "Kannada Wikisource",
      "source_number": 65,
      "section": "ಲಿಂಗಾತಿಶಯ ಪದ್ಧತಿ",
      "text": "ಉಣಲಡಿಗೆ ಹಲವಾಗಿ । ಕಣಿಕ ತಾನೊಂದಯ್ಯ\nಮಣಲೇಸು ದೈವ ಘನವಾಗಿ - ಲೋಕಕ್ಕೆ\nತ್ರಿಣಯನ ಸರ್ವಜ್ಞ",
      "locator": "https://kn.wikisource.org/wiki/ಸರ್ವಜ್ಞನ_ವಚನಗಳು",
      "fingerprint_sha256": "83f309aa3d0d84def9e863542d8287a4bfb455a93e43fbbbf5f69b0d9842e973",
      "source_license": "CC BY-SA (Wikisource work page)",
      "canonical_status": "pending",
      "authenticity_status": "not_assessed",
      "rights_status": "license_recorded_review_required",
      "editorial_status": "research",
