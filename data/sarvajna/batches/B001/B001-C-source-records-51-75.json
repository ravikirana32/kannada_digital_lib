    },
    {
      "candidate_id": "CAND-0066",
      "canonical_id": null,
      "source_id": "SRC-002",
      "source_name": "Kannada Wikisource",
      "source_number": 66,
      "section": "ಲಿಂಗಾತಿಶಯ ಪದ್ಧತಿ",
      "text": "ಹರಿಬ್ರಹ್ಮರೆಂಬವರು । ಹರನಿಂದಲಾದವರು\nಅರಸಿಂಗೆ ಆಳು ಸರಿಯಹನೆ - ಪಶುಪತಿಗೆ\nಸರಿ ಯಾರ ಕಾಣೆ ಸರ್ವಜ್ಞ",
      "locator": "https://kn.wikisource.org/wiki/ಸರ್ವಜ್ಞನ_ವಚನಗಳು",
      "fingerprint_sha256": "94b1a234cb9c32017016f3160e6d3bfd82867498e843815a923d418e738ef031",
      "source_license": "CC BY-SA (Wikisource work page)",
